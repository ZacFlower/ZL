# Google Drive API key (Google Cloud Console > APIs & Services > Credentials)
# Bật "Google Drive API" cho project, và nên giới hạn key theo HTTP referrer (domain web của bạn)
VITE_GDRIVE_API_KEY=

# ID của thư mục gốc trên Google Drive (phần sau /folders/ trong URL)
# Thư mục phải chia sẻ: "Bất kỳ ai có đường liên kết đều có thể xem"
VITE_GDRIVE_FOLDER_ID=

# Thông tin cửa hàng hiển thị trên web
VITE_SHOP_NAME=Zacflower
VITE_SHOP_PHONE=090 528 29 21
VITE_SHOP_ZALO=0905282921
VITE_SHOP_WHATSAPP=84905282921
VITE_SHOP_ADDRESS=65 Ngũ Hành Sơn, Đà Nẵng
VITE_SHOP_WEBSITE=https://zacflower.com
# Link Facebook page (copy từ thanh địa chỉ khi mở page), để trống thì ẩn nút
VITE_SHOP_FACEBOOK=

# ===== Trang quản lý (#/admin): thêm / sửa / xóa mẫu hoa lên Google Drive =====
# OAuth Client ID (Google Cloud Console > Credentials > OAuth 2.0 Client IDs > Web application)
# Authorized JavaScript origins: http://localhost:5173 (+ domain thật khi deploy)
VITE_GOOGLE_CLIENT_ID=
# Email được phép quản lý, cách nhau bằng dấu phẩy (để trống = ai đăng nhập có quyền Drive cũng vào được)
VITE_ADMIN_EMAILS=

# ===== Nhận đơn đặt hoa =====
# URL ứng dụng web Google Apps Script (apps-script/Code.gs). Để trống = khách đặt qua Zalo / WhatsApp.
# Email nhận đơn sửa trong Google Sheet, trang tính "Cài đặt", ô B2.
VITE_ORDER_ENDPOINT=
